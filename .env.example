# Server Port (must be 3000 in AI Studio preview)
PORT=3000

# MongoDB Connection URI
# Leave empty in sandbox/demo mode to use embedded MongoMemoryServer automatically.
# For Windows / local MongoDB Community Server:
# MONGODB_URI="mongodb://127.0.0.1:27017/cipherline_e2ee"
# For MongoDB Atlas:
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cipherline_e2ee"
MONGODB_URI=""

# JWT Signing Secret (replace with a strong 64-char random secret in production)
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_KEY_FOR_PRODUCTION"
JWT_EXPIRES_IN="12h"

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
