# MongoDB Atlas or local MongoDB URI (leave blank to use embedded MongoDB in dev/demo)
MONGODB_URI=""

# Strong random secret (>= 32 chars) for signing JWT session tokens
JWT_SECRET="REPLACE_WITH_64_CHAR_CSPRNG_HEX_SECRET"
JWT_EXPIRES_IN="12h"

# Optional comma-separated allowed origins in production
CORS_ORIGIN=""

# Application port (Cloud Run / AI Studio / Render default)
PORT="3000"
APP_URL="MY_APP_URL"
